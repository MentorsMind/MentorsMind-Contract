# Copy this file to .env and fill in values for your environment.
# docker-compose.yml refuses to start if any of these are missing.
# Never commit the real .env file.

# Stellar node image and container name
STELLAR_IMAGE=
STELLAR_CONTAINER_NAME=

# Host ports mapped to the node (Horizon / RPC / Friendbot / Soroban RPC)
HORIZON_PORT=
RPC_PORT=
FRIENDBOT_PORT=
SOROBAN_RPC_PORT=

# Network selection and feature flags
STELLAR_NETWORK=
CATCHUP_COMPLETE=
ENABLE_SOROBAN_RPC=
ENABLE_SOROBAN_HTTP=
ENABLE_FRIENDBOT=

# Internal service URLs
FRIENDBOT_URL=
HORIZON_URL=
RPC_URL=
SOROBAN_RPC_URL=
