        "tok_approved": { "description": "Token approved for treasury" },
        "tok_rejected": { "description": "Token rejected" },
        "deposited": { "description": "Funds deposited" },
        "allocated": { "description": "Funds allocated" },
        "distributed": { "description": "Funds distributed" },
        "admin_prop": { "description": "Admin change proposed" },
        "admin_acc": { "description": "Admin change accepted" },
        "burn_exec": { "description": "Token burn executed" },
        "auth_added": { "description": "Authorized caller added" },
        "pricing_coord": { "description": "Pricing coordination detected" },
        "rg_resumed": { "description": "Rate guard resumed" },
        "oplog": { "description": "Operation logged" },
        "deposit_from": { "description": "Deposit from address" },
        "alloc_exec": { "description": "Allocation executed" },
        "sched_dist": { "description": "Scheduled distribution" },
        "distrib_exec": { "description": "Distribution executed" },
        "buyback_ok": { "description": "Buyback succeeded" },
        "buyback_fail": { "description": "Buyback failed" }
      }
    },
    "subscript": {
      "events": {
        "subscribed": { "description": "User subscribed" },
        "expired": { "description": "Subscription expired" },
        "renewed": { "description": "Subscription renewed" },
        "cancelled": { "description": "Subscription cancelled" },
        "paused": { "description": "Subscription paused" }
      }
    },
    "streak": {
      "events": {
        "broken": { "description": "Streak broken" },
        "updated": { "description": "Streak updated" },
        "rewarded": { "description": "Streak reward distributed" }
      }
    },
    "velocity": {
      "events": {
        "exceeded": { "description": "Velocity limit exceeded" },
        "checked": { "description": "Velocity check performed" },
        "daily_reset": { "description": "Daily velocity counter reset" }
      }
    },
    "upgrade": {
      "events": {
        "proposed": { "description": "Upgrade proposed" },
        "applied": { "description": "Upgrade applied" },
        "signers_upd": { "description": "Signers list updated" },
        "admin_upd": { "description": "Admin updated" },
        "registered": { "description": "Contract registered" },
        "sub_added": { "description": "Subscriber added" },
        "sub_removed": { "description": "Subscriber removed" }
      }
    },
    "trs_anlyt": {
      "events": {
        "fee_revenue": { "description": "Fee revenue recorded" },
        "ref_payout": { "description": "Referral payout" },
        "ins_reserve": { "description": "Insurance reserve" },
        "metrics": { "description": "Analytics metrics" },
        "report_gen": { "description": "Report generated" }
      }
    },
    "sub_anlyt": {
      "events": {
        "metrics": { "description": "Subscription analytics metrics" },
        "metrics_upd": { "description": "Metrics updated" }
      }
    },
    "delegation": {
      "events": {
        "delegated": { "description": "Voting power delegated" },
        "undelegated": { "description": "Delegation revoked" },
        "suspended": { "description": "Delegation suspended" }
      }
    },
    "esc_factory": {
      "events": {
        "admin_prop": { "description": "Admin change proposed" },
        "admin_acc": { "description": "Admin change accepted" },
        "deployed": { "description": "Escrow deployed" },
        "impl_upg": { "description": "Implementation upgraded" },
        "anom_warn": { "description": "Anomaly warning" }
      }
    },
    "endorsmnt": {
      "events": {
        "endorsed": { "description": "Skill endorsed" },
        "removed": { "description": "Endorsement removed" },
        "re_endorsed": { "description": "Skill re-endorsed" }
      }
    },
    "isa": {
      "events": {
        "created": { "description": "ISA created" },
        "completed": { "description": "ISA completed" },
        "earning_shared": { "description": "Income share payment" },
        "payment_rec": { "description": "Payment recorded" },
        "payment_missed": { "description": "Payment missed" },
        "defaulted": { "description": "ISA defaulted" }
      }
    },
    "rate_limit": {
      "events": {
        "exceeded": { "description": "Rate limit exceeded" },
        "wl_added": { "description": "Address whitelisted" },
        "wl_removed": { "description": "Address removed from whitelist" }
      }
    }
  }
}
